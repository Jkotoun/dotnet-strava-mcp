@StravaMCP_HostAddress = http://localhost:5111

### Initialize
POST {{StravaMCP_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": { "name": "http-client", "version": "0.1" }
  }
}

### List tools
POST {{StravaMCP_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list"
}

### Call get_athlete_profile tool
POST {{StravaMCP_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "get_athlete_profile",
    "arguments": {}
  }
}

### Call get_recent_activities tool
POST {{StravaMCP_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "get_recent_activities",
    "arguments": { "count": 5 }
  }
}
